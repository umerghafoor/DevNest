{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devnest",
  "version": "1.1.1",
  "identifier": "com.devnest.devnest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/app.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevNest",
        "url": "/app.html",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 480,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
